# Modèle d'environnement PRODUCTION (préproduction privée Noma)
# NE JAMAIS renseigner de valeur réelle dans ce fichier versionné.
#
# Sur le serveur, UN SEUL fichier d'environnement, installé explicitement :
#   sudo deploy/gen-secrets.sh /opt/noma/shared/.env.production
# puis y ajouter NEXT_PUBLIC_TURNSTILE_SITE_KEY (clé publique, non secrète).
# Ce même fichier est lu par systemd (EnvironmentFile) ET sourcé avant le
# BUILD (la clé publique Turnstile est inline dans le bundle navigateur).
# Les secrets NOMA_IP_SECRET / NOMA_PROXY_SECRET sont générés par le script,
# jamais écrits à la main, jamais dans Git ni dans les messages.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Persistant ───────────────────────────────────────────────────────────────
NOMA_DB_PATH=/var/lib/noma/noma-guard.sqlite

# ── Budgets et quotas (INCHANGÉS — ne pas modifier sans accord) ──────────────
NOMA_DAILY_BUDGET_USD=1
NOMA_SEARCH_RESERVE_USD=0.05

# ── Interrupteurs ────────────────────────────────────────────────────────────
# Recherches DÉSACTIVÉES tant que le lot 4 n'est pas autorisé (503).
NOMA_SEARCH_DISABLED=1
# IA jamais désactivée ici : l'interrupteur n'a d'usage qu'en incident.
# NOMA_AI_DISABLED=1
# INTERDIT en production (contournements de développement ; vérifié par tests : le
# démarrage de la protection de recherche REFUSE si l'une est définie et non vide,
# et le prestataire de paiement fictif exige NODE_ENV=development ou test) :
#   NOMA_FAKE_PAYMENTS
#   NOMA_FAKE_PAYMENT_SECRET
#   NOMA_DEV_OTP_CONSOLE
#   NOMA_DEV_NOTIFY_CONSOLE
#   NOMA_DEV_PROXY
#   NOMA_FAKE_SOURCES
#   NOMA_TURNSTILE_DISABLED

# ── Turnstile (clés RÉELLES du domaine configuré) ────────────────────────────
NOMA_TURNSTILE_SECRET=<secret siteverify Cloudflare — jamais committé>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<clé publique du widget — fournie au BUILD>
NOMA_TURNSTILE_ACTION=search
NOMA_TURNSTILE_HOSTNAMES=<domaine.exemple>

# ── SMS : fournisseur Meno (lot SMS1 — voir SMS.md) ──────────────────────────
# DÉSACTIVÉ tant que NOMA_SMS_PROVIDER n'est pas « meno » ET que la clé n'est pas renseignée.
# Chaque SMS ACCEPTÉ coûte 15 F CFA (argent réel). Valeurs à renseigner UNIQUEMENT dans le fichier
# installé sur le serveur (/opt/noma/shared/.env.production), JAMAIS ici, JAMAIS dans Git.
# Avec « meno » en production, le démarrage est REFUSÉ si la clé est absente ou de format invalide,
# si NOMA_SMS_BASE_URL n'est pas en https, ou si NOMA_PUBLIC_URL / NOMA_AUTH_SECRET manquent.
#   NOMA_SMS_PROVIDER   none (défaut) ou meno ; « console » est refusé en production
#   NOMA_SMS_API_KEY    clé du fournisseur (SECRET, serveur seulement)
#   NOMA_SMS_BASE_URL   vide = https://meno.sublymus.com/api/external/sms
#   NOMA_PUBLIC_URL     origine https de l'application (lien des notifications), sans chemin
#   NOMA_SMS_DAILY_CAP  plafond TOTAL d'envois par jour UTC (vide = 1000 = 15 000 F CFA au plus)
#   NOMA_SMS_NOTIFICATION_SHARE_PERCENT  part du plafond réservée aux notifications (vide = 40 ; 1 à 90) ; le reste = budget des codes de connexion
#   NOMA_SMS_EXISTING_RESERVE_PERCENT    part du budget des codes réservée aux numéros qui ont DÉJÀ un compte (vide = 50 ; 0 à 90)
# NODE_ENV=production (ci-dessus) est INDISPENSABLE : hors production le transport meno n'est actif que vers un faux serveur local.
# Le BUILD se fait par `npm run build:production` (aucun secret transmis au build) : voir DEPLOIEMENT.md.
NOMA_SMS_PROVIDER=
NOMA_SMS_API_KEY=
NOMA_SMS_BASE_URL=
NOMA_PUBLIC_URL=
NOMA_SMS_DAILY_CAP=
NOMA_SMS_NOTIFICATION_SHARE_PERCENT=
NOMA_SMS_EXISTING_RESERVE_PERCENT=

# ── Proxy et pseudonymisation (générés côté serveur, jamais committés) ──────
NOMA_PROXY_SECRET=<généré par deploy/gen-secrets.sh>
NOMA_IP_SECRET=<généré par deploy/gen-secrets.sh>

# ── Divers ───────────────────────────────────────────────────────────────────
NOMA_BUDGET_TZ=Africa/Abidjan
CHROME_PATH=/usr/bin/google-chrome-stable
# OPENROUTER_API_KEY et GOOGLE_API_KEY/GOOGLE_CX restent dans poc/.env.local
# (côté serveur uniquement) — jamais ici, jamais côté navigateur.
