    "test:catalog-extraction-application": "NODE_ENV=test NODE_OPTIONS=--conditions=react-server node --import ./poc/node_modules/tsx/dist/loader.mjs --test --test-isolation=none tests/postgres/catalog-extraction-application.integration.test.ts",
