    "test:chunk-manifest": "NODE_ENV=test NODE_OPTIONS=--conditions=react-server node --import ./poc/node_modules/tsx/dist/loader.mjs --test --test-isolation=none tests/server/chunk-manifest.test.ts",
    "test:matching-chunks": "NODE_ENV=test NODE_OPTIONS=--conditions=react-server node --import ./poc/node_modules/tsx/dist/loader.mjs --test --test-isolation=none tests/postgres/matching-chunks.integration.test.ts"
