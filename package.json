    "test:real-search": "node --import ./poc/node_modules/tsx/dist/loader.mjs --test --test-isolation=none tests/real-search.test.ts",
    "test": "npm run test:contracts && npm run test:server && npm run test:stream && npm run test:real-search && npm run test:route",
